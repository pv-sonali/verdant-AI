# GEMINI_API_KEY: Required for Gemini AI crop disease detection and Agronomist AI.
# Get a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="your_gemini_api_key_here"

# PORT: Server port (defaults to 3000)
PORT=3000

# MONGODB_URI: (Optional) MongoDB Atlas Connection String
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
# If left empty, the app automatically uses local file-based persistence (data/scans.json & data/chats.json).
MONGODB_URI=""

# DATABASE_NAME: (Optional) Database name in MongoDB Atlas (defaults to 'verdant_ai')
DATABASE_NAME="verdant_ai"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"
